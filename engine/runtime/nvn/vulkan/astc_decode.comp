#version 450
// ASTC LDR 2D -> RGBA8 on the GPU. Bit-exact port of engine/runtime/nvn/astc.c (astc_decode_block, itself bit-exact
// with ARM astcenc decode_unorm8): endpoints expand to 16 bits (linear v * 257, sRGB v << 8 | 0x80), texel =
// (e0 * (64 - w) + e1 * w + 32) >> 6, top 8 bits kept. Error blocks -> magenta; HDR endpoint modes -> magenta endpoints
// for that partition. 32-bit integer ops only (no int64 on the device): the block is a uvec4, x = bits 0..31.
// One invocation per 128-bit block; texels outside width x height are not written.
// Tested against astc.c by engine/tools/astcgpu (every block size, sRGB / linear, pitch and block-linear sources).

layout(local_size_x = 64) in;

// Raw guest bytes of one mip level of one layer, from a 16-byte-aligned offset (src_off, in uints).
layout(std430, set = 0, binding = 0) readonly buffer Src { uint src[]; };
// RGBA8 (R in the low byte), one uint per texel, row-major width x height, from dst_off (in uints).
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uint dst[]; };

layout(push_constant) uniform PC {
    uint src_off, dst_off;   // in uints
    uint width, height;      // level size in texels
    uint bw, bh;             // ASTC footprint
    uint srgb;               // 1: sRGB endpoint expansion
    uint linear;             // 1: pitch-linear source (block (i,j) at j*stride + i*16); 0: Tegra block-linear
    uint stride;             // pitch-linear row stride in bytes
    uint wb, hb;             // blocks per row / column
    uint bh_log2, bd_log2;   // block-linear: GOBs per block in height / depth (log2)
} pc;

